{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "example:test_event_child_burst",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "example:particle/flash"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": false
			},
			"minecraft:emitter_rate_instant": {
