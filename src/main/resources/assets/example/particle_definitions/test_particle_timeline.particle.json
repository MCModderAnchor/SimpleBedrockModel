{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "example:test_particle_timeline",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "example:particle/flash"
			}
		},
		"events": {
			"mid_life_burst": {
				"particle_effect": {
					"effect": "example:test_event_child_burst",
					"type": "emitter"
				}
			},
			"on_particle_expire": {
				"log": "Particle expired with timeline event"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": false
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 2,
				"max_particles": 10
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 10
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, 1, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 3
			},
			"minecraft:particle_initial_speed": 3,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -5, 0],
				"linear_drag_coefficient": 0.5
			},
			"minecraft:particle_lifetime_events": {
				"expiration_event": "on_particle_expire",
				"timeline": {
					"1.5": "mid_life_burst"
				}
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.25, 0.25],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 32,
					"texture_height": 32,
					"uv": [0, 0],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFF00",
						"0.5": "#FFFF8800",
						"1.0": "#00FF0000"
					}
				}
			}
		}
	}
}
