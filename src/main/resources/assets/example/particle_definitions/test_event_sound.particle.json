{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "example:test_event_sound",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "example:particle/flash"
			}
		},
		"events": {
			"play_sound": {
				"sound_effect": {
					"event_name": "example:deagle_shoot"
				}
			},
			"on_create_log": {
				"log": "Sound emitter created"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": false
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.5
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:emitter_initialization": {
				"per_render_expression": "variable.size = 4 * (1 - v.particle_age / v.particle_lifetime);"
			},
			"minecraft:emitter_lifetime_events": {
				"creation_event": ["play_sound", "on_create_log"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.3
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.size", "variable.size"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 32,
					"texture_height": 32,
					"uv": [0, 0],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"0.5": "#AAFFFFAA",
						"1.0": "#00FFFF00"
					}
				}
			}
		}
	}
}
